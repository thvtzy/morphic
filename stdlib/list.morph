// ─────────────────────────────────────────────────────────
//  MORPHIC STANDARD LIBRARY — List module (Phase 115)
//
//  Prelude module like the Int/Char/String modules
//  (decision D2a); bodies crowned at library-build time,
//  shipped as data in src/stdlib.rs. The List family of
//  the frozen scope (STDLIB_SCOPE.md §2.6) is TWO-TIER
//  (decision D7a): `list_is_empty` is length-level and
//  ships at the Tier-1 standard (Z3-Verified ∧ golden-
//  exact, like its String sibling); the eleven element-
//  level entries ship at the Tier-2 standard — executed-
//  exact on the full battery, the tier printed in each
//  entry's doc below — because the verifier binds a List
//  parameter as its length only, so no element-level
//  entry can Verify at any body quality until the §3.9
//  list-element encoder lands post-1.0, with this
//  library as its test corpus.
//
//  Every Tier-2 body is a hand body in the Phase 95
//  statement vocabulary (While / Index / Append / Alloc
//  / Assign), so both executed judges reach it in full:
//  the in-process interpreter and the compiled runner.
//  `list_sort`'s body is a hand insertion sort at the
//  executed standard (the standing template body needs a
//  comparator parameter this concrete entry does not
//  have); `list_binary_search` ships a hand body per
//  the G5 scope-around (§2.6). No entry's body calls
//  another entry — each is self-contained, so a caller's
//  inlining of it renders and executes standalone.
//
//  Phase 135 (STDLIB_SCOPE.md Amendment 2, the 1.2
//  amendment): the five higher-order entries the G4
//  language build unblocked (list_map, list_filter,
//  list_fold, list_all, list_any) plus `range` join the
//  module at Tier-2, docs frozen verbatim by the
//  amendment. Their bodies are hand bodies in the same
//  Phase 115 vocabulary, applying the function parameter
//  through a Call — the Map/Filter/Fold IR forms do not
//  compile in Rust under the standing rendering (E0631,
//  measured at Phase 135), so the For-loop form is the
//  one vocabulary both executed judges reach in full,
//  here as everywhere in this module. `range` the entry
//  coexists with `range(...)` the quantifier domain
//  (a parser position, not a call) — the prelude-merge
//  check that proves it is tests/phase135_amendment_
//  build.rs's named instrument.
//
//  Phase 144 (the 1.3 re-tier, LIST_ENCODER_SCOPE.md
//  §5): the §3.9 list-element encoder landed (Phases
//  139–143: the paired array+length binding, the guard
//  discipline, the bounded-quantifier and fold-form
//  arms, UF composition over element terms), and
//  fifteen of this module's seventeen Tier-2 entries
//  stand Z3-Verified ∧ battery-exact with the bodies
//  below — they ship at Tier-1 from 1.3, their `doc:`
//  tier sentences updated at this re-tier, contract
//  sentences untouched. Two entries do not move:
//  `list_sort` (standing residue — its row 1 is the
//  is_permutation Predicate, §3.10's unencoded class,
//  and row 3 a two-binder forall past the Phase 94
//  envelope) and `list_binary_search` (the named
//  stretch: its element rows encode, but its
//  `require:` names `list_is_sorted(xs)`, whose
//  quantifier-shaped contract has no expression-level
//  denotation, so the precondition machinery cannot
//  assume it in the crown route — measured at Phase
//  144). Their tier sentences name the residues.
// ─────────────────────────────────────────────────────────

StdlibList {
spec list_is_empty {
    doc: "list_is_empty(xs) = true iff xs has no elements: len(xs) == 0 (STDLIB_SCOPE.md 2.6). Tier-1."

    input: xs: List<Int>
    output: Bool

    constraint: output == (len(xs) == 0)

    test "empty" { input: [] expect: true }

    test "singleton" { input: [7] expect: false }

    test "typical" { input: [1, 2, 3] expect: false }

    test "zero is an element" { input: [0] expect: false }
}

spec list_reverse {
    doc: "list_reverse(xs) = the elements of xs in reverse order; empty gives empty, a singleton gives itself (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>
    output: List<Int>

    constraint: len(output) == len(xs)
    constraint: forall i: Int in range(len(xs)): output[i] == xs[(len(xs) - 1) - i]

    test "empty" { input: [] expect: [] }

    test "singleton" { input: [5] expect: [5] }

    test "typical" { input: [1, 2, 3] expect: [3, 2, 1] }

    test "duplicates" { input: [3, 1, 4, 1, 5] expect: [5, 1, 4, 1, 3] }

    test "palindrome" { input: [1, 2, 1] expect: [1, 2, 1] }

    test "negatives" { input: [0, (0 - 1), 2] expect: [2, (0 - 1), 0] }
}

spec list_contains {
    doc: "list_contains(xs, x) = true iff some element of xs equals x; the empty list gives false (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>, x: Int
    output: Bool

    constraint: forall i: Int in range(len(xs)): xs[i] == x implies output == true
    constraint: (forall i: Int in range(len(xs)): xs[i] != x) implies output == false

    test "empty" { input: ([], 1) expect: false }

    test "singleton hit" { input: ([5], 5) expect: true }

    test "singleton miss" { input: ([5], 3) expect: false }

    test "typical hit" { input: ([1, 2, 3], 2) expect: true }

    test "typical miss" { input: ([1, 2, 3], 9) expect: false }

    test "all duplicates" { input: ([2, 2, 2], 2) expect: true }

    test "negative hit" { input: ([(0 - 3), 0, 7], (0 - 3)) expect: true }
}

spec list_sum {
    doc: "list_sum(xs) = the sum of the elements of xs; the empty list gives 0. Arithmetic is the language's standing Int arithmetic (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>
    output: Int

    constraint: output == fold(xs, 0, |acc, v| acc + v)

    test "empty" { input: [] expect: 0 }

    test "singleton" { input: [5] expect: 5 }

    test "typical" { input: [1, 2, 3] expect: 6 }

    test "cancelling" { input: [(0 - 4), 4] expect: 0 }

    test "mixed signs" { input: [10, (0 - 3), 7, (0 - 7)] expect: 7 }

    test "int maximum alone" { input: [9223372036854775807] expect: 9223372036854775807 }

    test "int minimum alone" { input: [(0 - 9223372036854775807 - 1)] expect: (0 - 9223372036854775807 - 1) }

    test "extremes cancel" { input: [9223372036854775807, (0 - 9223372036854775807 - 1)] expect: (0 - 1) }
}

spec list_product {
    doc: "list_product(xs) = the product of the elements of xs; the empty list gives 1, and any zero element gives 0 (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>
    output: Int

    constraint: output == fold(xs, 1, |acc, v| acc * v)

    test "empty" { input: [] expect: 1 }

    test "singleton" { input: [5] expect: 5 }

    test "typical" { input: [2, 3, 4] expect: 24 }

    test "zero element" { input: [0, 9223372036854775807] expect: 0 }

    test "negative factor" { input: [(0 - 2), 3] expect: (0 - 6) }

    test "two negatives" { input: [(0 - 1), (0 - 1)] expect: 1 }

    test "ones" { input: [1, 1, 1] expect: 1 }

    test "int minimum alone" { input: [(0 - 9223372036854775807 - 1)] expect: (0 - 9223372036854775807 - 1) }
}

spec list_min {
    doc: "list_min(xs) = Some(m) with m the least element of xs, or None when xs is empty — the empty case is a value, not a precondition (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>
    output: Option<Int>

    constraint: len(xs) == 0 implies output == None()
    constraint: forall i: Int in range(len(xs)): output.is_none() || output.unwrap() <= xs[i]
    constraint: output.is_some() implies exists i: Int in range(len(xs)): xs[i] == output.unwrap()

    test "empty" { input: [] expect: None() }

    test "singleton" { input: [5] expect: Some(5) }

    test "typical" { input: [3, 1, 4] expect: Some(1) }

    test "duplicates" { input: [2, 2] expect: Some(2) }

    test "negatives" { input: [(0 - 5), 0, (0 - 9)] expect: Some((0 - 9)) }

    test "extremes" { input: [9223372036854775807, (0 - 9223372036854775807 - 1)] expect: Some((0 - 9223372036854775807 - 1)) }
}

spec list_max {
    doc: "list_max(xs) = Some(m) with m the greatest element of xs, or None when xs is empty — the empty case is a value, not a precondition (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>
    output: Option<Int>

    constraint: len(xs) == 0 implies output == None()
    constraint: forall i: Int in range(len(xs)): output.is_none() || output.unwrap() >= xs[i]
    constraint: output.is_some() implies exists i: Int in range(len(xs)): xs[i] == output.unwrap()

    test "empty" { input: [] expect: None() }

    test "singleton" { input: [5] expect: Some(5) }

    test "typical" { input: [3, 1, 4] expect: Some(4) }

    test "duplicates" { input: [2, 2] expect: Some(2) }

    test "negatives" { input: [(0 - 5), (0 - 9)] expect: Some((0 - 5)) }

    test "extremes" { input: [(0 - 9223372036854775807 - 1), 9223372036854775807] expect: Some(9223372036854775807) }
}

spec list_take {
    doc: "list_take(xs, n) = the first n elements of xs, with n clamped into [0, len(xs)]: n <= 0 gives the empty list, n >= len(xs) gives xs unchanged (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>, n: Int
    output: List<Int>

    constraint: n <= 0 implies len(output) == 0
    constraint: n >= len(xs) implies output == xs
    constraint: (n > 0 && n < len(xs)) implies len(output) == n
    constraint: forall i: Int in range(len(output)): output[i] == xs[i]

    test "empty list" { input: ([], 3) expect: [] }

    test "zero" { input: ([1, 2, 3], 0) expect: [] }

    test "negative" { input: ([1, 2, 3], (0 - 2)) expect: [] }

    test "typical" { input: ([1, 2, 3], 2) expect: [1, 2] }

    test "exact length" { input: ([1, 2, 3], 3) expect: [1, 2, 3] }

    test "beyond length" { input: ([1, 2, 3], 99) expect: [1, 2, 3] }

    test "singleton" { input: ([5], 1) expect: [5] }
}

spec list_drop {
    doc: "list_drop(xs, n) = xs without its first n elements, with n clamped into [0, len(xs)]: n <= 0 gives xs unchanged, n >= len(xs) gives the empty list (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>, n: Int
    output: List<Int>

    constraint: n <= 0 implies output == xs
    constraint: n >= len(xs) implies len(output) == 0
    constraint: (n > 0 && n < len(xs)) implies len(output) == len(xs) - n
    constraint: forall i: Int in range(len(output)): n <= 0 implies output[i] == xs[i]
    constraint: forall i: Int in range(len(output)): n > 0 implies output[i] == xs[i + n]

    test "empty list" { input: ([], 3) expect: [] }

    test "zero" { input: ([1, 2, 3], 0) expect: [1, 2, 3] }

    test "negative" { input: ([1, 2, 3], (0 - 2)) expect: [1, 2, 3] }

    test "typical" { input: ([1, 2, 3], 2) expect: [3] }

    test "exact length" { input: ([1, 2, 3], 3) expect: [] }

    test "beyond length" { input: ([1, 2, 3], 99) expect: [] }

    test "singleton dropped" { input: ([5], 1) expect: [] }
}

spec list_is_sorted {
    doc: "list_is_sorted(xs) = true iff xs is non-strictly ascending (every adjacent pair a <= b); the empty list and singletons give true. The library form of Appendix A's is_sorted (STDLIB_SCOPE.md 2.6). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>
    output: Bool

    constraint: len(xs) <= 1 implies output == true
    constraint: forall i: Int in range(0, len(xs) - 1):
        output == true implies xs[i] <= xs[i + 1]
    constraint: forall i: Int in range(0, len(xs) - 1):
        xs[i] > xs[i + 1] implies output == false

    test "empty" { input: [] expect: true }

    test "singleton" { input: [5] expect: true }

    test "sorted" { input: [1, 2, 3] expect: true }

    test "unsorted" { input: [3, 1, 2] expect: false }

    test "all equal" { input: [5, 5, 5] expect: true }

    test "plateau" { input: [1, 2, 2, 3] expect: true }

    test "reverse sorted" { input: [3, 2, 1] expect: false }

    test "negatives sorted" { input: [(0 - 2), (0 - 1), 0] expect: true }

    test "late inversion" { input: [1, 3, 2] expect: false }
}

spec list_sort {
    doc: "list_sort(xs) = the elements of xs in non-strict ascending order; the output is a permutation of the input, judged on the executed battery (the is_permutation Predicate form is not a shipped entry, STDLIB_SCOPE.md 2.7). Empty and singleton lists give themselves (STDLIB_SCOPE.md 2.6). Tier-2: executed-exact on the full battery; standing residue at 1.3 — row 1 is the is_permutation Predicate (unencoded, 3.10) and row 3 a two-binder forall past the Phase 94 envelope (LIST_ENCODER_SCOPE.md 3.3)."

    input: xs: List<Int>
    output: List<Int>

    constraint: is_permutation(xs, output)
    constraint: len(output) == len(xs)
    constraint: forall i: Int, j: Int in range(len(output)): i < j implies output[i] <= output[j]

    test "empty" { input: [] expect: [] }

    test "singleton" { input: [5] expect: [5] }

    test "typical" { input: [3, 1, 2] expect: [1, 2, 3] }

    test "reverse sorted" { input: [5, 4, 3, 2, 1] expect: [1, 2, 3, 4, 5] }

    test "duplicates" { input: [2, 2, 1, 1] expect: [1, 1, 2, 2] }

    test "already sorted" { input: [1, 2, 3] expect: [1, 2, 3] }

    test "negatives" { input: [(0 - 1), 5, (0 - 3), 0] expect: [(0 - 3), (0 - 1), 0, 5] }
}

spec list_binary_search {
    doc: "list_binary_search(xs, x) = Some(i) with xs[i] == x when x occurs in the sorted list xs, or None when it does not. With duplicate targets any valid index satisfies the contract — the specific index is spec-silent. Hand body at the executed standard (the G5 scope-around, STDLIB_SCOPE.md 2.6): the body is a scan, because generated Rust cannot index a Vec by an Int variable (the language has no usize — G5), so the While-form binary search cannot compile; the frozen contract is the search semantics above, and per-entry complexity is deliberately outside the gate (STDLIB_SCOPE.md 3). Tier-2: executed-exact on the full battery; at 1.3 its element rows encode, but its require: is not assumable in the crown route — list_is_sorted's contract is quantifier-shaped, with no expression-level denotation for the precondition machinery — so no Verified claim is made (LIST_ENCODER_SCOPE.md 3.3; Phase 144 measurement)."

    input: xs: List<Int>, x: Int
    output: Option<Int>

    require: list_is_sorted(xs)

    constraint: output.is_none() || xs[output.unwrap()] == x
    constraint: (forall i: Int in range(len(xs)): xs[i] != x) implies output == None()

    test "empty" { input: ([], 5) expect: None() }

    test "singleton hit" { input: ([5], 5) expect: Some(0) }

    test "singleton miss" { input: ([5], 3) expect: None() }

    test "at start" { input: ([1, 3, 5, 7, 9], 1) expect: Some(0) }

    test "at end" { input: ([1, 3, 5, 7, 9], 9) expect: Some(4) }

    test "in middle" { input: ([1, 3, 5, 7, 9], 7) expect: Some(3) }

    test "between elements" { input: ([1, 3, 5, 7, 9], 4) expect: None() }

    test "too small" { input: ([1, 3, 5, 7, 9], 0) expect: None() }

    test "too large" { input: ([1, 3, 5, 7, 9], 10) expect: None() }

    test "negatives" { input: ([(0 - 5), (0 - 1), 2, 8], (0 - 1)) expect: Some(1) }
}

spec list_map {
    doc: "list_map(xs, f) = the list of f applied to each element of xs, in order; the empty list gives the empty list (STDLIB_SCOPE.md Amendment 2). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>, f: fn(Int) -> Int
    output: List<Int>

    constraint: len(output) == len(xs)
    constraint: forall i: Int in range(len(xs)): output[i] == f(xs[i])

    test "empty lambda" { input: ([], |x| x + 1) expect: [] }

    test "empty named" { input: ([], int_abs) expect: [] }

    test "singleton" { input: ([5], |x| x * 2) expect: [10] }

    test "typical" { input: ([1, 2, 3], |x| x + 1) expect: [2, 3, 4] }

    test "negation" { input: ([3, (0 - 5), 0], |x| 0 - x) expect: [(0 - 3), 5, 0] }

    test "identity at maximum" { input: ([9223372036854775807], |x| x) expect: [9223372036854775807] }

    test "named abs" { input: ([(0 - 3), 4, (0 - 6)], int_abs) expect: [3, 4, 6] }

    test "named sign" { input: ([(0 - 8), 0, 9], int_sign) expect: [(0 - 1), 0, 1] }
}

spec list_filter {
    doc: "list_filter(xs, p) = the elements of xs for which p holds, in their original order; the empty list gives the empty list, and a predicate that holds for no element gives the empty list (STDLIB_SCOPE.md Amendment 2). Tier-1: Z3-verified of exactly its two frozen rows and executed-exact on the full battery (LIST_ENCODER_SCOPE.md 3.3)."

    input: xs: List<Int>, p: fn(Int) -> Bool
    output: List<Int>

    constraint: len(output) <= len(xs)
    constraint: forall i: Int in range(len(output)): p(output[i]) == true

    test "empty lambda" { input: ([], |x| x > 0) expect: [] }

    test "all pass" { input: ([1, 2, 3], |x| x > 0) expect: [1, 2, 3] }

    test "none pass" { input: ([1, 2, 3], |x| x > 9) expect: [] }

    test "typical" { input: ([1, 2, 3, 4], |x| x % 2 == 0) expect: [2, 4] }

    test "negatives" { input: ([(0 - 2), (0 - 1), 0, 1], |x| x < 0) expect: [(0 - 2), (0 - 1)] }

    test "duplicates" { input: ([2, 2, 3, 3], |x| x == 2) expect: [2, 2] }

    test "named even" { input: ([1, 2, 3, 4, 5, 6], int_is_even) expect: [2, 4, 6] }

    test "named odd empty" { input: ([], int_is_odd) expect: [] }
}

spec list_fold {
    doc: "list_fold(xs, init, f) = the left fold of xs under f, starting from the accumulator init: f(f(f(init, x0), x1), ...) in element order; the empty list gives init (STDLIB_SCOPE.md Amendment 2). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>, init: Int, f: fn(Int, Int) -> Int
    output: Int

    constraint: output == fold(xs, init, f)

    test "empty sum" { input: ([], 42, |a, x| a + x) expect: 42 }

    test "empty product" { input: ([], 7, |a, x| a * x) expect: 7 }

    test "singleton" { input: ([5], 10, |a, x| a + x) expect: 15 }

    test "typical sum" { input: ([1, 2, 3, 4], 0, |a, x| a + x) expect: 10 }

    test "left order subtraction" { input: ([1, 2, 3], 100, |a, x| a - x) expect: 94 }

    test "negatives" { input: ([(0 - 5), 5], 3, |a, x| a + x) expect: 3 }

    test "named min" { input: ([4, 2, 8], 99, int_min) expect: 2 }

    test "named max init wins" { input: ([1, 2], 50, int_max) expect: 50 }
}

spec list_all {
    doc: "list_all(xs, p) = true iff p holds for every element of xs; the empty list gives true (vacuous truth) (STDLIB_SCOPE.md Amendment 2). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>, p: fn(Int) -> Bool
    output: Bool

    constraint: forall i: Int in range(len(xs)): p(xs[i]) == false implies output == false
    constraint: (forall i: Int in range(len(xs)): p(xs[i]) == true) implies output == true

    test "empty lambda" { input: ([], |x| x > 0) expect: true }

    test "all pass" { input: ([1, 2, 3], |x| x > 0) expect: true }

    test "one fails" { input: ([1, 0, 3], |x| x > 0) expect: false }

    test "singleton fail" { input: ([0], |x| x > 0) expect: false }

    test "negatives" { input: ([(0 - 1), (0 - 2)], |x| x < 0) expect: true }

    test "named even" { input: ([2, 4, 6], int_is_even) expect: true }

    test "named even one odd" { input: ([2, 3, 4], int_is_even) expect: false }

    test "named odd empty" { input: ([], int_is_odd) expect: true }
}

spec list_any {
    doc: "list_any(xs, p) = true iff p holds for at least one element of xs; the empty list gives false (STDLIB_SCOPE.md Amendment 2). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: xs: List<Int>, p: fn(Int) -> Bool
    output: Bool

    constraint: forall i: Int in range(len(xs)): p(xs[i]) == true implies output == true
    constraint: (forall i: Int in range(len(xs)): p(xs[i]) == false) implies output == false

    test "empty lambda" { input: ([], |x| x > 0) expect: false }

    test "none pass" { input: ([0, (0 - 1)], |x| x > 0) expect: false }

    test "one passes" { input: ([0, 5, 0], |x| x > 0) expect: true }

    test "singleton pass" { input: ([7], |x| x > 0) expect: true }

    test "all pass" { input: ([1, 2], |x| x > 0) expect: true }

    test "named even" { input: ([1, 3, 4], int_is_even) expect: true }

    test "named odd none" { input: ([2, 4], int_is_odd) expect: false }

    test "named even empty" { input: ([], int_is_even) expect: false }
}

spec range {
    doc: "range(lo, hi) = the ascending list [lo, lo + 1, ..., hi - 1]; lo == hi gives the empty list, and lo > hi gives the empty list — there is no descending form and no precondition (STDLIB_SCOPE.md Amendment 2). Tier-1: Z3-verified and executed-exact on the full battery (the 1.3 list-encoder campaign, LIST_ENCODER_SCOPE.md 3)."

    input: lo: Int, hi: Int
    output: List<Int>

    constraint: hi >= lo implies len(output) == hi - lo
    constraint: hi <= lo implies len(output) == 0
    constraint: forall i: Int in range(len(output)): output[i] == lo + i

    test "probe span" { input: (0, 3) expect: [0, 1, 2] }

    test "probe empty" { input: (0, 0) expect: [] }

    test "equal bounds" { input: (4, 4) expect: [] }

    test "reversed" { input: (5, 2) expect: [] }

    test "singleton" { input: (5, 6) expect: [5] }

    test "negative span" { input: ((0 - 3), 0) expect: [(0 - 3), (0 - 2), (0 - 1)] }

    test "typical" { input: (2, 5) expect: [2, 3, 4] }
}
}
}
