// ┌────────────────────────────────────────────────────────────┐
// │  M1: First self-synthesizable spec                          │
// │  Simple enough to complete synthesis in <30s               │
// │  is_sorted — checks if list is sorted ascending            │
// └────────────────────────────────────────────────────────────┘

TestModule {
spec is_sorted {
    input: list: List<Int>
    output: Bool

    constraint: if len(list) <= 1 then output == true
    constraint: forall i: Int in range(0, len(list) - 1):
        output == true implies list[i] <= list[i + 1]
    constraint: forall i: Int in range(0, len(list) - 1):
        list[i] > list[i + 1] implies output == false

    optimize: time < O(n)
    optimize: space < O(1)

    test "empty" { input: []; expect: true }
    test "single" { input: [5]; expect: true }
    test "sorted" { input: [1, 2, 3]; expect: true }
    test "unsorted" { input: [3, 1, 2]; expect: false }
    test "equal" { input: [5, 5, 5]; expect: true }
}
}
