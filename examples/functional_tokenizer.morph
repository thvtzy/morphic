// ┌────────────────────────────────────────────────────────────┐
// │  M0 Phase B: Functional-Style Tokenizer                     │
// │  Proof that Morphic IR can express compiler components      │
// │  WITHOUT self/&mut/OOP — pure functional struct passing     │
// └────────────────────────────────────────────────────────────┘
//
// ── S4 re-authoring record (2026-11-21, Phase 47) ───────────
//  This file was re-authored into the dialect the current
//  parser + typechecker accept; it previously failed
//  `morphic check`. The pre-re-authoring text is preserved
//  in git history. Semantics are preserved spec-for-spec —
//  every change below is a FORM change, and nothing was
//  silently weakened:
//
//   1. Module wrapper added: the items now live inside
//      `FunctionalTokenizer { ... }`. Without it the parser
//      consumed `type` as the module name and died at the
//      first type definition (line 9).
//   2. Alias type defs gained their trailing ';'
//      (`type TokenKind = Int;`). Record defs take none —
//      that is parse_type_def's grammar, not a style choice.
//   3. if…then…else constraints rewritten as guard rows,
//      the established module dialect (validator.morph's
//      note): `negated-guard||consequent` reads as
//      "guard implies consequent"; the negation of an
//      equality guard is written with '!=', which the
//      current parser accepts in this position (measured).
//   4. skip_whitespace: the original's two `invariant:`
//      lines are carried as `constraint:` lines with
//      identical expressions. Spec invariants are checked
//      with only the inputs in scope (measured type error:
//      "invariant: Undefined variable: 'output'"), so the
//      original form is outside the accepted dialect; as
//      postconditions the two lines state exactly what the
//      original asserted about the output state.
//   5. is_ident_start / is_ident_continue: the output
//      equation's disjunction is now parenthesized as a
//      whole. In the original text the parentheses covered
//      only the first disjunct, and under the parser's
//      precedence (|| loosest, == above it) the literal
//      reading was (output==range)||rest, not the intended
//      equation. The intended equation is what the mirrors
//      implement and what the hand-written tokenizer does.
//   6. Operators inside constraints are written tight,
//      per the established module dialect.
//
//  DROPPED, per spec, with reasons (also noted at each spec):
//   - tokenize_one, tokenize_all: BOTH original constraints
//     call methods on Result values (output.is_err(),
//     output.unwrap(), output.is_ok()). The spec language
//     has no method-call expression (there is no MethodCall
//     AST variant) — surfacing one is a language-owner
//     decision, still open. The two specs therefore carry
//     their signatures (and tokenize_all its optimize
//     bound) only; their behavior is pinned by the mirror
//     golden in tests/tokenizer_proof.rs.
//   - The in-spec tests of the five TokenizerState-input
//     specs (peek, next_char, skip_whitespace, tokenize_one,
//     tokenize_all — 9 tests) are written with record
//     literals, which the test syntax cannot express (no
//     record-literal expression exists). They are
//     transcribed verbatim into the mirror golden in
//     tests/tokenizer_proof.rs — the M2 precedent for specs
//     whose test syntax cannot bind their inputs. The three
//     Char classifiers' 9 tests use char literals (F4,
//     Phase 45) and are carried in-spec below, unchanged.
//
//  One cross-artifact divergence, recorded here and pinned
//  by a dedicated test in tests/tokenizer_proof.rs: the
//  spec's tokenize tests stamp each token with the line/col
//  where the token STARTS; the M0 hand-written tokenizer
//  stamps the position AFTER the token (its push_token
//  reads the already-advanced state). The mirrors follow
//  the spec. Everything else — lexemes, kinds, positions,
//  error cases — agrees with the hand-written tokenizer.
//
// ── Phase 79 completion record (2026-11-22) ─────────────
//  This file is COMPLETED in this phase. The Phase 47
//  record above stands as the history of the interim
//  shape; every item it left open is closed here:
//
//   1. tokenize_one / tokenize_all constraints RESTORED.
//      The language-owner decisions the Phase 47 record
//      waited on were taken in the M1-features audit
//      (M1_FEATURES_AUDIT.md) and ratified 2026-11-22:
//      D1a method calls (native method-call expressions
//      + the closed builtin table), D2a IR field access
//      (a field-access IR node + record values in the
//      interpreter and in Z3), D3a named record literals,
//      D5a the Z3 Char scalar encoding. Phases 73–78
//      built that machinery and proved it on a scratch
//      restoration of this module; the two specs below
//      now carry the original constraint text verbatim.
//   2. The 9 record-literal tests RESTORED in-spec, in
//      the D3a named form (TokenizerState { … },
//      Token { … }); inputs and expected outputs are
//      identical to the mirror golden's transcriptions,
//      which stay in tests/tokenizer_proof.rs as the
//      cross-check. The module again carries all 18 of
//      the original tests in-spec.
//   3. The divergence recorded above is RESOLVED by
//      D4a: token columns are START-normative. The
//      hand-written tokenizer's push_token is corrected
//      to stamp the token's start, and the dedicated
//      test in tests/tokenizer_proof.rs flips from
//      pinning the divergence to pinning the agreement.
//      The mirrors followed the spec throughout; nothing
//      in this file moved for D4a.
//
// ── Phase 82 amendment record (2026-11-22) ─────────────
//  ONE deliberate deviation from the verbatim restoration
//  above, owner-ratified 2026-11-22 (Phase 80's amendment
//  option A, from the gate re-run's decision round):
//   - tokenize_one's first constraint row gains row 2's
//     own end-of-input disjunct:
//     `|| state.pos >= len(state.source)`. As restored,
//     the row refuted the output this module's own
//     "end-of-input" test demands — Ok with no new token
//     at pos >= len(source) reads 0 == 0 + 1 on the row,
//     proven mechanically in Phase 80 — so no test-correct
//     body could verify against it. With the disjunct the
//     rows and the tests are jointly satisfiable. Row 2
//     is NOT amended. The residue is the one Phase 80
//     stated for option A, re-measured in Phase 82: at
//     end-of-input inputs the amended row 1 constrains
//     nothing further (row 2 and the tests bound the
//     output there), and the whitespace-only-remainder
//     corner — skipping to end-of-input from a non-EOF
//     input and returning Ok without growth — stays
//     unlicensed, so a mirror-faithful body remains
//     refutable on that corner.

FunctionalTokenizer {

// ── Types ──────────────────────────────────────────────────

// Token kinds, coded as Int (ADT simulated). The codes are
// the discriminants of the TokenKind enum in
// tests/tokenizer_proof.rs:
// 0=Ident, 1=IntLit, 2=StringLit, 3=LParen, 4=RParen,
// 5=LBrace, 6=RBrace, 7=Colon, 8=Semicolon, 9=Comma,
// 10=Lt, 11=Gt, 12=Eq
type TokenKind = Int;

type Token = {
    kind: TokenKind,
    lexeme: String,
    line: Int,
    col: Int
}

type TokenizerState = {
    source: String,
    pos: Int,
    line: Int,
    col: Int,
    tokens: List<Token>
}

type StepResult = Result<TokenizerState, String>;

// ── State Accessors (pure functions) ──────────────────────

spec peek {
    input: state: TokenizerState
    output: Option<Char>

    // Original form: two if-then constraints (guard rows
    // per re-authoring note 3). Tests restored in-spec in
    // the D3a named form (Phase 79); the mirror golden in
    // tests/tokenizer_proof.rs keeps its copies.
    constraint: state.pos<len(state.source)||output==None()
    constraint: state.pos>=len(state.source)||output==Some(state.source[state.pos])

    test "non-empty" { input: TokenizerState { source: "hi", pos: 0, line: 1, col: 1, tokens: [] } expect: Some('h') }
    test "at-end" { input: TokenizerState { source: "", pos: 0, line: 1, col: 1, tokens: [] } expect: None() }
}

spec next_char {
    input: state: TokenizerState
    output: TokenizerState

    // Original form: one unconditional constraint plus an
    // if-then-else on peek(state)==Some('\n'); the then
    // branch's conjunction is split into its two rows.
    // Fields no row pins (line in the else case, source,
    // tokens) are carried over unchanged — the mirror in
    // tests/tokenizer_proof.rs states the full update.
    // Test restored in-spec in the D3a named form
    // (Phase 79); the mirror golden keeps its copy.
    constraint: output.pos==state.pos+1
    constraint: peek(state)!=Some('\n')||output.line==state.line+1
    constraint: peek(state)!=Some('\n')||output.col==1
    constraint: peek(state)==Some('\n')||output.col==state.col+1

    test "normal" {
        input: TokenizerState { source: "ab", pos: 0, line: 1, col: 1, tokens: [] }
        expect: TokenizerState { source: "ab", pos: 1, line: 1, col: 2, tokens: [] }
    }
}

// ── Tokenizer Core ────────────────────────────────────────

spec is_whitespace {
    input: c: Char
    output: Bool

    constraint: output==(c==' '||c=='\t'||c=='\n'||c=='\r')

    test "space" { input: ' ' expect: true }
    test "letter" { input: 'a' expect: false }
    test "newline" { input: '\n' expect: true }
}

spec is_ident_start {
    input: c: Char
    output: Bool

    // Disjunction parenthesized as a whole (note 5).
    constraint: output==((c>='a'&&c<='z')||(c>='A'&&c<='Z')||c=='_')

    test "lower" { input: 'a' expect: true }
    test "digit" { input: '5' expect: false }
    test "underscore" { input: '_' expect: true }
}

spec is_ident_continue {
    input: c: Char
    output: Bool

    // Disjunction parenthesized as a whole (note 5).
    constraint: output==(is_ident_start(c)||(c>='0'&&c<='9'))

    test "letter" { input: 'x' expect: true }
    test "digit-ok" { input: '7' expect: true }
    test "special" { input: '{' expect: false }
}

spec skip_whitespace {
    input: state: TokenizerState
    output: TokenizerState

    // The original's two invariant lines, carried as
    // constraints with identical expressions (note 4).
    // They are all the spec states: the full behavior
    // (advance to the first non-whitespace char, tracking
    // line/col through next_char) is the mirror's.
    // Tests restored in-spec in the D3a named form
    // (Phase 79); the mirror golden keeps its copies.
    constraint: output.pos>=state.pos
    constraint: len(output.source)==len(state.source)

    test "no-whitespace" {
        input: TokenizerState { source: "hi", pos: 0, line: 1, col: 1, tokens: [] }
        expect: TokenizerState { source: "hi", pos: 0, line: 1, col: 1, tokens: [] }
    }

    test "skip-spaces" {
        input: TokenizerState { source: "  hi", pos: 0, line: 1, col: 1, tokens: [] }
        expect: TokenizerState { source: "  hi", pos: 2, line: 1, col: 3, tokens: [] }
    }
}

spec tokenize_one {
    input: state: TokenizerState
    output: StepResult

    // Both original constraints RESTORED (Phase 79): they
    // call the D1a builtin methods on the Result output
    // (is_err / unwrap / is_ok) — typechecker-resolved
    // since Phase 74, Z3-encodable since Phase 76. The
    // constraint text is the original's verbatim, spacing
    // included: the one place the module's tight dialect
    // (note 6) is not applied, because the restoration is
    // verbatim by design — with ONE owner-ratified
    // exception (Phase 82, amendment A): row 1 gains row
    // 2's own end-of-input disjunct,
    // `|| state.pos >= len(state.source)`, because as
    // restored the row refuted this spec's own
    // "end-of-input" test (Phase 80's mechanical proof).
    // Row 2 stays verbatim. Tests restored in-spec in the
    // D3a named form; the mirror golden in
    // tests/tokenizer_proof.rs keeps its copies.
    constraint: output.is_err() || len(output.unwrap().tokens) == len(state.tokens) + 1 || state.pos >= len(state.source)
    constraint: output.is_ok() || state.pos >= len(state.source)

    test "keyword-spec" {
        input: TokenizerState { source: "spec", pos: 0, line: 1, col: 1, tokens: [] }
        expect: Ok(TokenizerState { source: "spec", pos: 4, line: 1, col: 5, tokens: [
            Token { kind: 0, lexeme: "spec", line: 1, col: 1 }
        ] })
    }

    test "end-of-input" {
        input: TokenizerState { source: "", pos: 0, line: 1, col: 1, tokens: [] }
        expect: Ok(TokenizerState { source: "", pos: 0, line: 1, col: 1, tokens: [] })
    }
}

spec tokenize_all {
    input: state: TokenizerState
    output: Result<List<Token>, String>

    // The original constraint RESTORED (Phase 79): it
    // calls the D1a builtin methods on the Result output
    // (is_err / unwrap, then the List method len) —
    // expressible and encodable since Phases 74/76. The
    // constraint text is the original's verbatim (see
    // tokenize_one's note). Tests restored in-spec in the
    // D3a named form; the mirror golden in
    // tests/tokenizer_proof.rs keeps its copies.
    constraint: output.is_err() || output.unwrap().len() >= len(state.tokens)
    optimize: time < O(n)

    test "simple-spec" {
        input: TokenizerState { source: "spec sort", pos: 0, line: 1, col: 1, tokens: [] }
        expect: Ok([
            Token { kind: 0, lexeme: "spec", line: 1, col: 1 },
            Token { kind: 0, lexeme: "sort", line: 1, col: 6 }
        ])
    }

    test "empty" {
        input: TokenizerState { source: "", pos: 0, line: 1, col: 1, tokens: [] }
        expect: Ok([])
    }
}

}
